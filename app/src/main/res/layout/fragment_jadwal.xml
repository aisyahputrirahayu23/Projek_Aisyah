<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mr_bg"
    tools:context=".Jadwal.JadwalFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:text="Jadwal obat"
            android:textColor="@color/mr_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Strip tanggal: diisi dari Kotlin -->
        <LinearLayout
            android:id="@+id/layoutHari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp" />

        <TextView
            android:id="@+id/tvJumlahObat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="Obat aktif (3)"
            android:textColor="@color/mr_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/listViewObat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Tombol + mengambang -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabTambahJadwal"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Tambah obat"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/mr_ink"
        android:textSize="28sp"
        app:backgroundTint="@color/mr_coral"
        app:cornerRadius="28dp" />

</FrameLayout>